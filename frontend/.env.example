# Google OAuth Web client ID (same value as backend GOOGLE_CLIENT_ID).
VITE_APP_CLIENT_ID=

# Leave unset (or empty) in local dev to use same-origin `/api` (Vite proxy → FastAPI) so HttpOnly cookies work.
# Set to e.g. http://127.0.0.1:8000 only if you call the API cross-origin and use Authorization: Bearer instead of cookies.
VITE_API_URL=
