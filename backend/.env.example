DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/hse_ai_news
# E2E_BOOTSTRAP_SECRET=
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:5173
SESSION_COOKIE_NAME=session
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_PATH=/
# ENABLE_SUMMARY_NIGHTLY_SCHEDULER=true
# SUMMARY_SCHEDULE_HOUR=3
# SUMMARY_SCHEDULE_TIMEZONE=UTC
# PER_USER_FILTER_BATCH=500
# PER_USER_FILTER_TOP_PER_BATCH=25
# PER_USER_DIGEST_LIMIT=50
# KEYWORD_EXTRACTOR_MAX_QUERY_CHARS=450
# SUMMARY_JOB_SECRET=
# --- NewsAPI (newsapi.org) daily news source ---
# Get a free Developer key at https://newsapi.org/register (100 req/day, ~24h delay).
NEWS_API_KEY=
# NEWS_API_LANGUAGE=en
# NEWS_REQUEST_PAGE_SIZE=100
# NEWS_MAX_ARTICLES=100
# --- LLM backend (OpenAI-compatible /v1/chat/completions) ---
# Hosted default (OpenRouter): set OPENROUTER_API_KEY and OPENROUTER_MODEL.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
#
# Local LM Studio instead (no key, no rate limits): point LLM_BASE_URL at the
# local server, set OPENROUTER_MODEL to a loaded model id, and bump the timeout.
# LLM_BASE_URL=http://127.0.0.1:1234/v1/chat/completions
# OPENROUTER_MODEL=qwen/qwen3-4b-2507
# LLM_TIMEOUT_SECONDS=120
#
# Default endpoint (override only when switching backends):
# LLM_BASE_URL=https://openrouter.ai/api/v1/chat/completions
# LLM_TIMEOUT_SECONDS=60
