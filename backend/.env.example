DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/hse_ai_news

# Optional: enables POST /auth/e2e/bootstrap-session for Playwright (header X-E2E-Bootstrap-Secret).
# Use a long random value locally; never set in production.
# E2E_BOOTSTRAP_SECRET=

# Google Sign-In: must match the frontend VITE_APP_CLIENT_ID (OAuth 2.0 Web client ID).
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Secret for signing session JWTs returned by POST /auth/google-login (use a long random value in prod).
JWT_SECRET=change-me-to-a-long-random-string

# Browser origins allowed by CORS (comma-separated).
CORS_ORIGINS=http://localhost:5173

# HttpOnly session cookie. On HTTPS in production set COOKIE_SECURE=true (and keep SameSite=lax unless cross-site).
# SameSite=none requires COOKIE_SECURE=true.
SESSION_COOKIE_NAME=session
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_PATH=/

# Nightly summary job (APScheduler): SUMMARY_SCHEDULE_HOUR:00 in SUMMARY_SCHEDULE_TIMEZONE (IANA).
# Default 03:00 UTC, generating the digest for the previous calendar day. Set false to disable.
# ENABLE_SUMMARY_NIGHTLY_SCHEDULER=true
# SUMMARY_SCHEDULE_HOUR=3
# SUMMARY_SCHEDULE_TIMEZONE=UTC

# GDELT DOC API (https://api.gdeltproject.org). No API key required; free and rate-limited.
# Caps the daily article pool size. Reduce if your LLM provider rate-limits per-user filter calls.
# GDELT_MAX_ARTICLES=2000
# GDELT_REQUEST_MAX_RECORDS=250
# PER_USER_FILTER_BATCH=500
# PER_USER_FILTER_TOP_PER_BATCH=25
# PER_USER_DIGEST_LIMIT=50
# KEYWORD_EXTRACTOR_MAX_QUERY_CHARS=450

# Optional: POST /tasks/summary/run-bulk with header X-Summary-Job-Secret — runs job for all users (same as midnight).
# SUMMARY_JOB_SECRET=

# OpenRouter key (https://openrouter.ai). Free-tier models work with the default below.
# Empty key disables LLM generation; the nightly job falls back to inserting placeholder rows.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Interests: public.interests (user_id → users.id, interests text). HSE coursework DDL.
# Summaries: public.summaries (user_id → users.id, summary text, created_at). HSE coursework DDL.
# Transports: public.transports.data JSONB — telegramBotToken, telegramChatId (null until set).
# Server calls Telegram sendMessage with the user's token + chat id. Table: HSE coursework DDL.
