# Copy to backend/.env — values here are examples only.
# Use the same user/password as in pgAdmin or `psql` (defaults are often NOT postgres/postgres).
# PostgreSQL (psycopg v3 driver):
DATABASE_URL=postgresql+psycopg://YOUR_USER:YOUR_PASSWORD@localhost:5432/YOUR_DATABASE

# Google Sign-In: must match the frontend VITE_APP_CLIENT_ID (OAuth 2.0 Web client ID).
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Secret for signing session JWTs returned by POST /auth/google-login (use a long random value in prod).
JWT_SECRET=change-me-to-a-long-random-string

# Browser origins allowed by CORS (comma-separated).
CORS_ORIGINS=http://localhost:5173

# HttpOnly session cookie. On HTTPS in production set COOKIE_SECURE=true (and keep SameSite=lax unless cross-site).
# SameSite=none requires COOKIE_SECURE=true.
SESSION_COOKIE_NAME=session
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_PATH=/
